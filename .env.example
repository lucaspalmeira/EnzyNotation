# Host paths for the future target-server deployment. Create these directories
# before invoking Docker Compose.
ENZYNOTATION_INPUT_ROOT=./input
ENZYNOTATION_RESULTS_ROOT=./results
ENZYNOTATION_LOGS_ROOT=./logs
ENZYNOTATION_DB_ROOT=/srv/enzynotation/databases
ENZYNOTATION_MODEL_ROOT=/srv/enzynotation/models
ENZYNOTATION_CACHE_ROOT=/srv/enzynotation/cache

# Image references may be replaced by immutable digest-pinned references.
ENZYNOTATION_IMAGE=enzynotation:local
CLEAN_IMAGE=moleculemaker/clean-image-amd64
FOLDSEEK_IMAGE=ghcr.io/steineggerlab/foldseek:10-941cd33
