{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enzynotation.org/schema/v1/family.schema.json",
  "title": "EnzyNotation enzyme-family rules",
  "description": "Generic domain, motif, and structural rules for one enzyme family.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "family", "rules"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": {
          "$ref": "#/$defs/familyIdentifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "uniqueItems": true
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domains", "motifs", "structures"],
      "properties": {
        "domains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/domainRule"
          }
        },
        "motifs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/motifRule"
          }
        },
        "structures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/structureRule"
          }
        }
      },
      "anyOf": [
        {
          "properties": {
            "domains": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "motifs": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "structures": {
              "minItems": 1
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "stableIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "familyIdentifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "ecString": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[1-9][0-9]*\\.[1-9][0-9]*\\.[1-9][0-9]*\\.[1-9][0-9]*$"
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]*\\.[1-9][0-9]*\\.[1-9][0-9]*\\.-$"
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]*\\.[1-9][0-9]*\\.-\\.-$"
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]*\\.-\\.-\\.-$"
        }
      ]
    },
    "requirement": {
      "enum": ["required", "supporting", "forbidden"]
    },
    "candidateECs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ecString"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "domainRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "source",
        "signature_id",
        "requirement",
        "min_count"
      ],
      "properties": {
        "rule_id": {
          "$ref": "#/$defs/stableIdentifier"
        },
        "description": {
          "type": "string"
        },
        "source": {
          "enum": ["pfam", "hmmer", "interproscan"]
        },
        "signature_id": {
          "type": "string",
          "minLength": 1
        },
        "requirement": {
          "$ref": "#/$defs/requirement"
        },
        "min_count": {
          "type": "integer",
          "minimum": 0
        },
        "max_count": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "minimum_query_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maximum_evalue": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "candidate_ecs": {
          "$ref": "#/$defs/candidateECs"
        }
      }
    },
    "positionConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_to", "min_offset", "max_offset"],
      "properties": {
        "relative_to": {
          "enum": [
            "sequence_start",
            "sequence_end",
            "domain_start",
            "domain_end"
          ]
        },
        "domain_rule_id": {
          "$ref": "#/$defs/stableIdentifier"
        },
        "min_offset": {
          "type": "integer"
        },
        "max_offset": {
          "type": "integer"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "relative_to": {
                "enum": ["domain_start", "domain_end"]
              }
            },
            "required": ["relative_to"]
          },
          "then": {
            "required": ["domain_rule_id"]
          }
        }
      ]
    },
    "motifRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "pattern",
        "requirement",
        "min_occurrences"
      ],
      "properties": {
        "rule_id": {
          "$ref": "#/$defs/stableIdentifier"
        },
        "description": {
          "type": "string"
        },
        "pattern": {
          "type": "string",
          "format": "regex",
          "minLength": 1
        },
        "requirement": {
          "$ref": "#/$defs/requirement"
        },
        "min_occurrences": {
          "type": "integer",
          "minimum": 0
        },
        "max_occurrences": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "position": {
          "$ref": "#/$defs/positionConstraint"
        },
        "candidate_ecs": {
          "$ref": "#/$defs/candidateECs"
        }
      }
    },
    "structureRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "reference_ids",
        "requirement",
        "minimum_tm_score",
        "minimum_query_coverage"
      ],
      "properties": {
        "rule_id": {
          "$ref": "#/$defs/stableIdentifier"
        },
        "description": {
          "type": "string"
        },
        "reference_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "requirement": {
          "$ref": "#/$defs/requirement"
        },
        "minimum_tm_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimum_query_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "candidate_ecs": {
          "$ref": "#/$defs/candidateECs"
        }
      }
    }
  }
}
