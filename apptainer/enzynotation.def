Bootstrap: docker
From: python:3.12-slim

%labels
    org.opencontainers.image.title EnzyNotation
    org.opencontainers.image.version 0.1.0
    org.opencontainers.image.description Evidence-based protein enzyme annotation pipeline

%files
    pyproject.toml /opt/enzynotation/pyproject.toml
    README.md /opt/enzynotation/README.md
    src /opt/enzynotation/src
    configs /opt/enzynotation/configs
    scripts /opt/enzynotation/scripts

%post
    apt-get update
    apt-get install --no-install-recommends -y bash ca-certificates hmmer ncbi-blast+
    rm -rf /var/lib/apt/lists/*
    python -m pip install --no-cache-dir /opt/enzynotation
    mkdir -p /work/input /work/results /work/logs /databases /models /cache

%environment
    export ENZYNOTATION_DB_ROOT=/databases
    export ENZYNOTATION_MODEL_ROOT=/models
    export ENZYNOTATION_CACHE_ROOT=/cache
    export ENZYNOTATION_RESULTS_ROOT=/work/results
    export ENZYNOTATION_LOGS_ROOT=/work/logs

%runscript
    exec enzynotation "$@"

%test
    enzynotation --version
